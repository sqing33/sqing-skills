+func (s *Service) UpdateNotifPrefs(ctx context.Context, userID int64, prefs NotifPrefs) error {
+	var buf bytes.Buffer
+	if err := json.NewEncoder(&buf).Encode(prefs); err != nil {
+		return err
+	}
+	_, err := s.db.Exec(ctx, "UPDATE users SET notification_prefs = ? WHERE id = ?", buf.String(), userID)
+	return err
+}
+
+type NotifPrefs struct {
+	Events     []string `json:"events"`
+	QuietHours [2]int   `json:"quiet_hours"`
+}
