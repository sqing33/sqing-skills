+func shouldSend(prefs user.NotifPrefs, event string, now time.Time) bool {
+	for _, e := range prefs.Events {
+		if e == event {
+			break
+		}
+	}
+	h := now.Hour()
+	if prefs.QuietHours[0] < prefs.QuietHours[1] {
+		return h < prefs.QuietHours[0] || h >= prefs.QuietHours[1]
+	}
+	return h >= prefs.QuietHours[0] && h < prefs.QuietHours[1]
+}
