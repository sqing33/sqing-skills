# code-council 配置示例 — 复制到 .env 后填实际值

# 供应商(provider 名见 pi CLI 文档)
CODE_COUNCIL_PROVIDER=openai

# 模型
CODE_COUNCIL_MODEL=gpt-5.6-sol

# 选填
CODE_COUNCIL_THINKING=high                 # 思考档: off | minimal | low | medium | high | xhigh | max
CODE_COUNCIL_MAX_RETRIES=3                 # pi 调用失败重试次数
CODE_COUNCIL_RETRY_BACKOFF_SEC=3           # 重试退避基数 (实际 sleep = backoff * attempt)
CODE_COUNCIL_AUDIT_LOG=${HOME}/.minimax/agents/mavis/code-council-audit.logl
